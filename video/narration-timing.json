    {
      "id": "c03",
      "startFrame": 300,
      "endFrame": 420,
      "audioStart": 10.14,
      "audioEnd": 13.802,
      "duration": 3.662,
      "ratePercent": 24,
      "tempo": 1.27869,
      "text": "Em 10 de junho de 2018, o último conjunto de dados do Opportunity chegou de Marte."
    },
    {
      "id": "c04",
      "startFrame": 420,
      "endFrame": 540,
      "audioStart": 14.14,
