    {
      "id": "c07",
      "startFrame": 780,
      "endFrame": 930,
      "audioStart": 26.14,
      "audioEnd": 30.7,
      "duration": 4.56,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "Mas elas vivem em arquivos técnicos, em inglês, feitos para especialistas."
    },
    {
      "id": "c08",
      "startFrame": 930,
      "endFrame": 1170,
      "audioStart": 31.14,
      "audioEnd": 36.756,
      "duration": 5.616,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "Para muitas crianças, a ciência parece estar do outro lado de uma porta que ninguém abriu."
    },
    {
      "id": "c09",
      "startFrame": 1170,
      "endFrame": 1350,
      "audioStart": 39.14,
      "audioEnd": 42.572,
      "duration": 3.432,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "Não falta curiosidade. Falta acesso."
