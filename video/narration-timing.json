      "startFrame": 3600,
      "endFrame": 3750,
      "audioStart": 120.14,
      "audioEnd": 124.676,
      "duration": 4.536,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "Ela não está só vendo ciência. Está fazendo as perguntas que a ciência faz."
