      "startFrame": 3300,
      "endFrame": 3450,
      "audioStart": 110.14,
      "audioEnd": 114.628,
      "duration": 4.488,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "Uma imagem incompleta e ruidosa, durante uma tempestade de poeira."
