      "audioStart": 105.14,
      "audioEnd": 109.7991,
      "duration": 4.6591,
      "ratePercent": 24,
      "tempo": 1.06094,
      "text": "Em 10 de junho de 2018, sol 5111, o último conjunto de dados chegou."
