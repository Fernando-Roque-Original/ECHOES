    {
      "id": "c24",
      "startFrame": 3450,
      "endFrame": 3600,
      "audioStart": 115.14,
      "audioEnd": 119.799,
      "duration": 4.659,
      "ratePercent": 24,
      "tempo": 1.04034,
      "text": "Não uma despedida. O Opportunity encontrou evidências de ambientes antigos com água."
