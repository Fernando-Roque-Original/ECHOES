      "endFrame": 780,
      "audioStart": 20.14,
      "audioEnd": 25.156,
      "duration": 5.016,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "A NASA já produziu algumas das histórias mais extraordinárias da humanidade."
