      "startFrame": 540,
      "endFrame": 600,
      "audioStart": 18.14,
      "audioEnd": 19.796,
      "duration": 1.656,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "A história, não."
    },
    {
      "id": "c06",
