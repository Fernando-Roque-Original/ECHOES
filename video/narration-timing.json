    {
      "id": "c10",
      "startFrame": 1350,
      "endFrame": 1560,
      "audioStart": 45.14,
      "audioEnd": 50.852,
      "duration": 5.712,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "O After the Signal transforma o arquivo científico da NASA em uma experiência interativa."
    },
    {
      "id": "c11",
      "startFrame": 1560,
      "endFrame": 1650,
      "audioStart": 52.14,
      "audioEnd": 54.756,
      "duration": 2.616,
      "ratePercent": -2,
      "tempo": 1.0,
      "text": "Uma criança consegue explorar sozinha."
