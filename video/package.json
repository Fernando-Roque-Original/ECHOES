{
  "name": "echos-film",
  "private": true,
  "version": "0.1.0",
  "description": "Remotion presentation for ECHOES",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-public-assets.mjs",
    "export:srt": "node scripts/export-captions.mjs",
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PitchFilm out/after-the-signal.mp4",
    "render:30": "remotion render src/index.ts Echos30En out/echos-abandoned-not-forgotten-30s-en.mp4",
    "export:srt:30": "node scripts/export-echos30-captions.mjs",
    "still": "remotion still src/index.ts PitchFilm out/poster.png --frame=5100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
